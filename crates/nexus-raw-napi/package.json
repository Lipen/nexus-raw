{
  "name": "nexus-raw",
  "version": "0.1.0",
  "description": "Node bindings for nexus-raw: the nxr surface as promises over Nexus raw storage",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "binding.cjs",
    "binding.d.ts",
    "npm"
  ],
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.cjs --dts binding.d.ts",
    "build:debug": "napi build --platform --js binding.cjs --dts binding.d.ts"
  },
  "napi": {
    "binaryName": "nexus-raw",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5"
  }
}
