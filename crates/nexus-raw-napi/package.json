{
  "name": "nexus-raw",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lipen/nexus-raw.git"
  },
  "homepage": "https://lipen.github.io/nexus-raw/",
  "keywords": [
    "nexus",
    "nexus-raw",
    "artifacts",
    "sha256",
    "cli",
    "devops"
  ],
  "description": "Node bindings for nexus-raw: the nxr surface as promises over Nexus raw storage",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js",
    "binding.cjs",
    "binding.d.ts"
  ],
  "engines": {
    "node": ">= 18"
  },
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "build": "napi build --platform --release --js binding.cjs --dts binding.d.ts",
    "build:debug": "napi build --platform --js binding.cjs --dts binding.d.ts"
  },
  "napi": {
    "binaryName": "nexus-raw",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.6"
  }
}
